# Development values for the containers in docker-compose.yml. Copy to .env: cp .env.example .env
API_PORT=3000
GRPC_PORT=50051
HEALTH_PORT=3001

DATABASE_HOST=account-db
DATABASE_PORT=5432
DATABASE_NAME=account
# One user per service: it owns the database, runs the migrations and reads/writes the data
DATABASE_USER=account
DATABASE_PASSWORD=account-db-dev

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=account
RABBITMQ_PASSWORD=account-rabbitmq-dev

REDIS_HOST=redis
REDIS_USER=account
REDIS_PASSWORD=account-redis-dev

# Shared token every internal gRPC caller (wallet) sends as metadata x-service-token
GRPC_TOKEN=internal-grpc-dev

# Ed25519 pair of the internal user JWT (dev only). account signs with the private key; wallet and order hold only the public one
USER_TOKEN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIAE83mHTOrFWAUOeEV04wOTFpUBeSmAZU2tVswq4DJiq\n-----END PRIVATE KEY-----\n
USER_TOKEN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEALxCEnICerfG52kOtFCaYrwczs5XMniydqmd9Si/Pf2I=\n-----END PUBLIC KEY-----\n
# The session cookie is Secure; browsers accept it on http://localhost and http://127.0.0.1
SESSION_COOKIE_SECURE=true

RATE_LIMITS_AUTH_PER_IP=5/1h
RATE_LIMITS_AUTH_PER_EMAIL=3/1h
RATE_LIMITS_LOGIN_PER_IP=30/1h
RATE_LIMITS_PRIVATE_READ_PER_IP=600/1m
RATE_LIMITS_PRIVATE_READ_PER_ACCOUNT=300/1m

LOG_LEVEL=debug
